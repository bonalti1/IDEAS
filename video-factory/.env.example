# Copy to .env. Every value is optional: anything missing falls back to a
# local fake provider / file store / local disk, so the app always runs.

API_PORT=8787
DATA_DIR=data
# false = refuse to start when a provider key is missing (use in production)
FAKE_MISSING_PROVIDERS=true
# Optional shared bearer token for /api/* (internal use)
API_TOKEN=

# --- OpenAI: scene analysis, plan, prompts, image + clip review; GPT Image candidates
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.5
OPENAI_VISION_REASONING=medium
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=high
OPENAI_IMAGE_ENABLED=true

# --- Google: Nano Banana Pro stage images + Veo 3.1 transitions
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
GEMINI_IMAGE_SIZE=2K
VEO_MODEL=veo-3.1-generate-preview
VEO_RESOLUTION=720p

# --- fal.ai: Kling / Seedance challengers + SAM 2 masks
FAL_KEY=
FAL_KLING_ENDPOINT=fal-ai/kling-video/v3/pro/image-to-video
FAL_KLING_ENABLED=true
FAL_SEEDANCE_ENDPOINT=bytedance/seedance-2.5/image-to-video
FAL_SEEDANCE_ENABLED=true
FAL_SAM2_ENDPOINT=fal-ai/sam2/image

# --- Clips
VIDEO_DURATION_SEC=8
VIDEO_POLL_INTERVAL_SEC=10
VIDEO_MAX_POLLS=90
CLIP_REVIEW_FRAMES=4

# --- Supabase (records). Apply supabase/migrations first. Service-role key: server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (media)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional public/custom domain; otherwise signed URLs are used
R2_PUBLIC_BASE_URL=
R2_SIGNED_URL_TTL_SEC=3600

# --- Inngest (durable jobs). When false, jobs run in-process.
INNGEST_ENABLED=false
INNGEST_APP_ID=alto-video-factory
# INNGEST_EVENT_KEY= / INNGEST_SIGNING_KEY= are read by the Inngest SDK in production
# INNGEST_DEV=1 to use a local `npx inngest-cli dev` server

# --- Final render
# ffmpeg = built-in title cards; remotion = animated Remotion cards (needs Chrome headless shell)
RENDER_ENGINE=ffmpeg
REMOTION_BROWSER_EXECUTABLE=
# PNG logo for the watermark (defaults to an "ALTO PRO" text badge)
ALTO_LOGO_FILE=
