# Trade Tech Pro server configuration.
# Copy this file to server/.env and fill in the keys you have.
# Any key you leave blank keeps that feature in demo mode (simulated data).

# Anthropic API key — powers the "Pregúntale a TTP" AI assistant.
# Get one at https://platform.claude.com/
ANTHROPIC_API_KEY=

# Google Maps Platform key — powers address autocomplete (Places API),
# geocoding, and automatic roof measurement (Solar API).
# Enable "Places API", "Geocoding API", and "Solar API" on the key.
# Get one at https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=

# Regrid API token — loads real property/parcel boundaries for the fence
# estimator. Get one at https://app.regrid.com/
REGRID_API_KEY=

# RentCast API key — powers property data (bedrooms, baths, sq ft, year built).
# Free tier: 50 lookups/month. Get one at https://app.rentcast.io/app/api
RENTCAST_API_KEY=

# Web Push (lead alerts that buzz the contractor's phone, app open or closed).
# Generate once: npx web-push generate-vapid-keys → paste the two keys here.
# VAPID_SUBJECT is any mailto: you control. Leave blank to disable push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@alto-pro.com

# Private demo passcode — make up any secret string. Add it to a widget link as
# ?demo=<this value> (e.g. /w/alto-demo?demo=mysecret) to run the quote widget
# UNLIMITED for recording sales demos. Demo runs don't save or forward a lead.
# Leave blank to disable; public links stay rate-limited regardless.
DEMO_PASS=

# Google Maps JS key restricted to your domain — powers the map shown in the
# browser (address picker, roof outline). Different from GOOGLE_MAPS_API_KEY
# above, which is used server-side. Leave blank and the map won't load.
MAPS_BROWSER_KEY=

# OpenAI — fallback for the AI assistant when ANTHROPIC_API_KEY isn't set,
# and powers Whisper transcription for the quick-invoice voice input.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Meta Pixel ID for ad tracking on public pages. Leave blank to disable.
META_PIXEL_ID=

# --- Data persistence ---
# Postgres/Supabase connection string. Without this, contractor/lead/job data
# lives in a local JSON file that is WIPED on every deploy or idle spin-down
# on ephemeral hosts like Render. Required before any real client signs up.
DATABASE_URL=
# Set to 1 to make the server refuse to boot without DATABASE_URL, instead of
# silently falling back to the (data-losing) local JSON file store.
REQUIRE_DB=

# --- Portal access keys — pick strong, unique secrets for each ---
# Owner's private Headquarters (/hq): portfolio, idea board, AI advisor.
# ONLY this key opens it — staff keys (even ADMIN_KEY) do not.
HQ_KEY=
# Full admin dashboard (/admin): pause/reactivate accounts, edit any client's
# site/bot, see all leads and payments.
ADMIN_KEY=
# Customer-service command center (/cs): tasks, AI auto-fix, client sites.
# ADMIN_KEY also works here.
CS_KEY=
# Sales closer portal (/closer): create new client accounts + sales toolkit.
# ADMIN_KEY also works here.
CLOSER_KEY=

# --- Billing (Stripe) ---
# One Stripe Payment Link per plan (create them in Stripe → Payment Links).
# No setup fee on any plan. The webhook tags each client's plan automatically
# from the amount paid ($67 / $197 / $297).
STRIPE_LINK_PRO=
STRIPE_LINK_WIDGET=
STRIPE_LINK_COMPLETE=
# Legacy single link — still used as the COMPLETE ($297/mo) link when
# STRIPE_LINK_COMPLETE is blank.
STRIPE_PAYMENT_LINK=
# Signing secret for the Stripe webhook (Dashboard → Webhooks → your endpoint
# at /api/stripe/webhook). Verifies invoice.paid / payment_failed / etc.
STRIPE_WEBHOOK_SECRET=

# --- Custom domains for clients (optional) ---
# Cloudflare API token + zone ID: lets the onboarding "connect your domain"
# feature create the CNAME/SSL automatically. Leave blank to do it manually.
CF_API_TOKEN=
CF_ZONE_ID=
CF_CNAME_TARGET=app.alto-pro.com
# Cloudflare account ID (different from the zone ID above) — required for the
# "Comprar y conectar" one-click domain purchase in onboarding (Cloudflare
# Registrar API, beta). One-time setup in the Cloudflare dashboard:
#   1. Billing profile with a payment method (purchases charge it directly).
#   2. Default registrant contact (Manage Account → Address Book).
#   3. Accept the Domain Registration Agreement.
#   4. CF_API_TOKEN needs Account → Registrar Domains: Edit, plus
#      Zone → Zone: Read and Zone → DNS: Edit on all zones (to point the
#      freshly bought domain's zone at Render).
# Domains are registered under this account, not the client's.
CF_ACCOUNT_ID=

# Registrant contact sent with each purchase (WHOIS data; privacy-redacted
# where the extension supports it). If these are blank, Cloudflare falls back
# to the account's default address book entry — which can only be created in
# the dashboard under Domain Registration → Manage Domains (no API for it),
# so setting these env vars is the more reliable path. Phone is E.164 with a
# dot: +1.9565551234. CF_REG_ORG and CF_REG_COUNTRY (default US) are optional.
CF_REG_NAME=
CF_REG_ORG=
CF_REG_EMAIL=
CF_REG_PHONE=
CF_REG_STREET=
CF_REG_CITY=
CF_REG_STATE=
CF_REG_ZIP=
CF_REG_COUNTRY=US

# Render API access — lets the server register bought/connected client domains
# as Render custom domains so Render routes them and issues the SSL cert.
# API key: Render dashboard → Account Settings → API Keys.
# Service id: the srv-… id in the service's dashboard URL.
RENDER_API_KEY=
RENDER_SERVICE_ID=
# Hostname the client-domain DNS records point at (the service's onrender host)
RENDER_ORIGIN=tradetechpro.onrender.com

# --- Inbound lead webhook (optional) ---
# Shared secret for HighLevel (or any system) posting sales leads to
# /api/hl/lead. Make up any string and put the same one in HighLevel.
HL_WEBHOOK_SECRET=

# --- GHL calendar on the landing (optional) ---
# Permanent scheduling link of the ALTO-PRO Calendar (GHL → Calendars →
# ⋮ Share → copy Scheduling Link). When set, the quiz's success screen embeds
# it so fresh leads can book their call immediately, prefilled with the name
# and phone they just gave. Blank = success screen stays as-is.
GHL_BOOKING_URL=
